{
  "name": "expo-google-tag-manager",
  "version": "0.1.0",
  "description": "Expo config plugin that sets up Google Tag Manager for Firebase on iOS and Android during prebuild",
  "scripts": {
    "build": "tsc --build plugin",
    "clean": "tsc --build plugin --clean",
    "lint": "eslint plugin",
    "test": "jest",
    "prepare": "tsc --build plugin",
    "typecheck": "tsc -p plugin/__tests__"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-config-plugin",
    "google-tag-manager",
    "gtm",
    "firebase",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amerllica/expo-google-tag-manager.git"
  },
  "bugs": {
    "url": "https://github.com/amerllica/expo-google-tag-manager/issues"
  },
  "author": "amerllica <amerllica@gmail.com> (https://github.com/amerllica)",
  "license": "MIT",
  "homepage": "https://github.com/amerllica/expo-google-tag-manager#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7",
    "@babel/preset-typescript": "^7",
    "@types/jest": "^29.2.1",
    "@types/node": "^24",
    "babel-jest": "^29",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.27",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/plugin"
    ],
    "transform": {
      "\\.ts$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "peerDependencies": {
    "expo": "*"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "files": [
    "app.plugin.js",
    "expo-module.config.json",
    "plugin/build/**",
    "!plugin/build/tsconfig.tsbuildinfo",
    "ios/**",
    "android/**",
    "!android/build/**"
  ]
}
